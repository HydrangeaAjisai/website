---
import Navbar from '../components/Navbar.astro';
import Live2D from '../components/Live2D.astro';
import { ClientRouter } from 'astro:transitions';
interface Props {
	description?: string;
	heading?: string;
	subtitle?: string;
	backHref?: string;
	backLabel?: string;
}

const { description, heading, subtitle, backHref, backLabel = '返回首页' } = Astro.props;
const siteTitle = '欲求生富贵，需下死工夫';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/jpeg" href="/favicon-ajisai.jpg" />
		<meta name="generator" content={Astro.generator} />
		<title>{siteTitle}</title>
		{description && <meta name="description" content={description} />}
		<slot name="head" />
		<ClientRouter fallback="swap" />
	</head>
	<body>
		<div class="wrapper">
			<Navbar />
			{heading && (
				<header class="page-header">
					<h1>{heading}</h1>
					{subtitle && <p>{subtitle}</p>}
				</header>
			)}
			<slot />
			{backHref && (
				<footer class="page-footer">
					<p><a href={backHref}>← {backLabel}</a></p>
				</footer>
			)}
			<Live2D />
		</div>
	</body>
</html>

<style>
	:root {
		--bg-page: #1a1a2e;
		--bg-card: #333344;
		--text-primary: #e0e0e0;
		--text-heading: #f0f0f0;
		--text-secondary: #a0a0a0;
		--text-muted: #777;
		--text-nav: #aaa;
		--border-color: #444;
		--border-light: #333;
		--link-hover: #66b3ff;
	}

	[data-theme="light"] {
		--bg-page: #f9f9f9;
		--bg-card: #e0e0e0;
		--text-primary: #333;
		--text-heading: #222;
		--text-secondary: #666;
		--text-muted: #888;
		--text-nav: #555;
		--border-color: #ddd;
		--border-light: #eee;
		--link-hover: #0066cc;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
		line-height: 1.6;
		color: var(--text-primary);
		background: var(--bg-page);
		transition: color 1s, background 1s;
	}

	.wrapper {
		width: 100%;
		max-width: 800px;
		padding: 0 1.5rem;
		box-sizing: border-box;
		margin: 0 auto;
	}

	.page-header {
		margin-top: 4rem;
		margin-bottom: 3rem;
	}

	.page-header h1 {
		font-size: 2.5rem;
		margin: 0 0 0.5rem;
		color: var(--text-heading);
	}

	.page-header p {
		font-size: 1.2rem;
		color: var(--text-secondary);
		margin: 0;
	}

	.page-footer {
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border-color);
	}

	.page-footer a {
		color: var(--text-nav);
		text-decoration: none;
	}

	.page-footer a:hover {
		color: var(--link-hover);
	}

	.katex {
		color: var(--text-primary);
	}

	.katex-display {
		margin: 1rem 0;
		overflow-x: auto;
	}
  	blockquote {
    	background-color: #04040433;
    	padding: 8px 12px;
    	border-radius: 4px;
    	border-left: 3px solid #666;
    	margin: 1em 0;
    	font-size: 0.95em;
  	}

  	blockquote p {
    	margin: 0;
  	}
</style>
