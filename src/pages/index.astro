---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
const notes = (await getCollection('notes')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);
---

<Layout title="Ajisai · 喜欢拍拍照" description="我是 Ajisai，喜欢拍拍照。这里放着我的学习笔记，也留一点空间给照片和偶尔想写下来的事。">
  <main>
    <header class="hero">
      <p class="eyebrow">AJISAI / 个人空间</p>
      <h1>你好，我是 <span>Ajisai.</span></h1>
      <p class="intro">喜欢拍拍照。</p>
      <p class="description">这里放着我的学习笔记，也留一点空间，<br class="desktop-break" />给照片和偶尔想写下来的事。</p>
      <a class="button" href="/note">翻翻我的笔记 <span aria-hidden="true">↗</span></a>
      <div class="decoration" aria-hidden="true"><span></span><i></i></div>
    </header>
    <section aria-labelledby="notes-heading">
      <div class="section-heading">
        <div><p class="eyebrow">NOTES & IDEAS</p><h2 id="notes-heading">最近的笔记</h2></div>
        <a href="/note">查看全部 ↗</a>
      </div>
      <div class="notes">
        {notes.map((note, index) => (
          <a class="note" href={`/note/${note.id}`}>
            <span class="number" aria-hidden="true">0{index + 1}</span>
            <div><p class="meta">{note.data.category || '学习笔记'}</p><h3>{note.data.title}</h3></div>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>
    <aside><span aria-hidden="true">✳</span><p>这个小站正在慢慢丰富，<br />谢谢你来看看。</p></aside>
  </main>
  <footer><a href="/">Ajisai.</a><p>© {new Date().getFullYear()} Ajisai</p></footer>
</Layout>

<style>
  .hero { position: relative; isolation: isolate; padding: 4rem 0 4.5rem; overflow: hidden; }
  .eyebrow { font-size: .68rem; font-weight: 600; letter-spacing: .16em; color: var(--text-secondary); margin: 0 0 1.2rem; }
  h1 { font-size: clamp(2.2rem, 7vw, 3.65rem); letter-spacing: -.045em; line-height: 1.25; margin: 0 0 1.4rem; color: var(--text-heading); }
  h1 span { white-space: nowrap; color: var(--link-hover); }
  .intro { font-size: 1.5rem; margin: 0 0 1rem; }
  .description { color: var(--text-secondary); font-size: .95rem; line-height: 1.9; margin: 0 0 2rem; }
  .button { display: inline-flex; align-items: center; gap: 2rem; background: var(--text-heading); color: var(--bg-page); border-radius: 999px; padding: .8rem 1.3rem; font-size: .9rem; font-weight: 600; text-decoration: none; }
  .button:hover { background: var(--link-hover); }
  .decoration { position: absolute; z-index: -1; width: 14rem; height: 17rem; right: 1rem; top: 5rem; opacity: .35; pointer-events: none; transform: rotate(12deg); border: 1px solid var(--border-color); border-radius: 6rem 6rem .5rem .5rem; background: radial-gradient(ellipse at 60% 30%, #a099cf30, transparent 70%); }
  .decoration span { position: absolute; width: 8rem; height: 8rem; border-radius: 50%; border: 1px solid var(--border-color); top: 3rem; left: 3rem; }
  .decoration i { position: absolute; height: 1px; width: 12rem; background: var(--border-color); bottom: 3rem; left: 1rem; }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 1.4rem; }
  .section-heading .eyebrow { margin-bottom: .4rem; }
  h2 { margin: 0; font-size: 1.4rem; color: var(--text-heading); }
  .section-heading > a { color: var(--text-secondary); text-decoration: none; font-size: .8rem; white-space: nowrap; }
  .notes { border-top: 1px solid var(--border-color); }
  .note { display: flex; gap: 1.5rem; align-items: center; padding: 1.4rem .25rem; border-bottom: 1px solid var(--border-color); text-decoration: none; color: var(--text-primary); }
  .number { color: var(--text-secondary); font-size: .75rem; font-variant-numeric: tabular-nums; }
  .meta { font-size: .73rem; color: var(--text-secondary); margin: 0 0 .3rem; }
  h3 { font-size: 1rem; font-weight: 500; margin: 0; overflow-wrap: anywhere; }
  .arrow { margin-left: auto; color: var(--text-secondary); }
  .note:hover h3, .note:hover .arrow, .section-heading > a:hover { color: var(--link-hover); }
  aside { display: flex; align-items: center; gap: 1rem; margin: 3.5rem 0; }
  aside > span { color: var(--link-hover); font-size: 2rem; }
  aside p { font-size: .85rem; line-height: 1.9; color: var(--text-secondary); margin: 0; }
  footer { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 0 2rem; border-top: 1px solid var(--border-color); }
  footer a { text-decoration: none; color: var(--text-heading); font-size: 1.1rem; font-weight: 700; }
  footer p { color: var(--text-secondary); font-size: .75rem; margin: 0; }
  a:focus-visible { outline: 2px solid var(--link-hover); outline-offset: 5px; }
  @media (max-width: 600px) { .hero { padding: 2.5rem 0 3rem; } .decoration { right: -6rem; opacity: .18; } .note { gap: 1rem; } .desktop-break { display: none; } }
</style>
