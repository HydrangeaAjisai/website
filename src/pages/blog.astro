</Layout>

<style>
	article {
		margin-bottom: 2.5rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--border-light);
	}

	h2 {
		font-size: 1.5rem;
		margin: 0 0 0.25rem;
		color: var(--text-primary);
	}

	p {
		margin: 0;
	}
</style>
