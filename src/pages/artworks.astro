---
import Layout from '../layouts/Layout.astro';
import photos from '../data/photos.json';
---

<Layout title="照片 · Ajisai" description="喜欢拍拍照。这里是 Ajisai 镜头里的一些片段。">
	<header>
		<h1>照片</h1>
		<p>喜欢拍拍照，留下眼前的一些片段。</p>
	</header>

	<main>
		<section class="gallery" aria-label="摄影作品">
			{photos.map((photo, index) => (
				<figure>
					<a href={`/photos/${photo.file}`} target="_blank" rel="noopener" aria-label={`查看照片 ${photo.name} 大图 (新标签页)`}>
						<img src={`/photos/thumbs/${photo.file}`} width={photo.width} height={photo.height} alt={`Ajisai 的摄影作品 ${photo.name}`} loading={index < 2 ? 'eager' : 'lazy'} decoding="async" />
					</a>
					<figcaption><span>{String(index + 1).padStart(2, '0')}</span><span>点击查看大图 ↗</span></figcaption>
				</figure>
			))}
		</section>
	</main>

	<footer>
		<p><a href="/">← 返回首页</a></p>
	</footer>
</Layout>

<style>
	header {
		margin-top: 4rem;
		margin-bottom: 3rem;
	}

	h1 {
		font-size: 2.5rem;
		margin: 0 0 0.5rem;
		color: var(--text-heading);
	}

	header p {
		font-size: 1.2rem;
		color: var(--text-secondary);
		margin: 0;
	}

	.gallery {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem 1.25rem;
		align-items: start;
	}
	figure { margin: 0; min-width: 0; }
	figure a { display: block; border-radius: 6px; overflow: hidden; background: var(--bg-card); }
	figure a:focus-visible { outline: 2px solid var(--link-hover); outline-offset: 4px; }
	figure img { display: block; width: 100%; height: auto; }
	figcaption { display: flex; justify-content: space-between; gap: 1rem; margin-top: .65rem; font-size: .75rem; color: var(--text-secondary); }
	@media (max-width: 520px) { .gallery { grid-template-columns: 1fr; } }


	footer {
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border-color);
	}

	footer a {
		color: var(--text-nav);
		text-decoration: none;
	}

	footer a:hover {
		color: var(--link-hover);
	}
</style>
